{
  "name": "@arabica-social/mcp",
  "version": "0.1.0",
  "description": "Local MCP server for interacting with arabica.social records",
  "type": "module",
  "bin": {
    "arabica-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lexicons:update": "lex-cli pull && tsx scripts/generate-lexicons.ts",
    "generate": "tsx scripts/generate-lexicons.ts",
    "check-generated": "tsx scripts/generate-lexicons.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/cli.ts serve"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@atcute/atproto": "4.0.4",
    "@atcute/client": "5.1.1",
    "@atcute/lexicons": "2.1.0",
    "@atcute/tid": "1.1.4",
    "@atproto/oauth-client-node": "0.3.1",
    "@modelcontextprotocol/sdk": "1.27.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@atcute/lex-cli": "3.3.0",
    "@types/node": "^22.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.22.0"
}
